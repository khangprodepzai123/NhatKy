<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/Moingay"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:backgroundTint="#AB1D1D">

    <TextView
        android:id="@+id/tieude"
        android:layout_width="375dp"
        android:layout_height="40dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        android:text="Tiêu đề"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ngaygio"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginStart="308dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:text="Ngày"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tieude" />
    <Button
        android:id="@+id/btnViet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Viết"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ngaygio" />
</androidx.constraintlayout.widget.ConstraintLayout>